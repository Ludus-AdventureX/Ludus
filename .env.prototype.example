# Guest Simulation Alpha deployment environment (compose.prototype.yaml).
# Copy to .env.prototype and fill in real values. Never commit real values;
# .gitignore keeps .env.prototype out of version control.

# Database (persisted in the decision_lab_prototype_db volume)
POSTGRES_DB=decision_lab
POSTGRES_USER=decision_lab
POSTGRES_PASSWORD=<strong-random-password>

# Host port the web container binds to. The integration lane points a
# temporary HTTPS ingress (e.g. `cloudflared tunnel --url http://localhost:3000`)
# at this port; that tunnel URL is the single public HTTPS origin.
WEB_PORT=3000

# Public origin served by the HTTPS ingress. Browsers only ever see this
# origin: the web container proxies /api/* to FastAPI internally.
WEB_ORIGIN=https://<guest-alpha-origin>
NEXT_PUBLIC_API_BASE=/api

# Guest Alpha switches. Guest data is created by the API runtime when the
# flag is on; fixtures replace live providers, so no model API key is needed.
ENABLE_GUEST_ALPHA=true
FIXTURE_MODE=true

# Live model execution (deep-analysis worker + quick analyses). Leave blank
# to stay on the deterministic fixture provider. To go live, set
# FIXTURE_MODE=false and fill in the OpenAI-compatible endpoint 4-tuple;
# the API key never leaves this file (gitignored) and is never logged.
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Analysis worker queue polling interval (seconds).
WORKER_POLL_INTERVAL_SECONDS=2.0

# Auth session contract (AuthSettings, env prefix AUTH_).
# Production values: unique random secret, secure cookies over HTTPS only,
# and the exact public HTTPS origin served by the ingress.
AUTH_JWT_SECRET=<at-least-32-random-bytes>
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_MINUTES=720
AUTH_ALLOWED_ORIGINS=["https://<guest-alpha-origin>"]
