# Copy to .env for local development only. Never commit real values.

# Database
POSTGRES_DB=decision_lab
POSTGRES_USER=decision_lab
POSTGRES_PASSWORD=<local-development-password>
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://decision_lab:<local-development-password>@localhost:5432/decision_lab

# Web/API origins and cookie policy
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
COOKIE_SECURE=false

# Application security: generate unique random values locally; never reuse examples.
JWT_SECRET=<at-least-32-random-bytes>
CSRF_SECRET=<at-least-32-random-bytes>
CONNECTOR_MASTER_KEY=<base64-encoded-32-byte-key>

# Auth session contract (AuthSettings, env prefix AUTH_). Placeholders only.
# Production MUST override AUTH_JWT_SECRET and set AUTH_COOKIE_SECURE=true.
# Cookie/header names (session, CSRF) are fixed contract values, not configurable here.
AUTH_JWT_SECRET=<at-least-32-random-bytes>
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_MINUTES=720
AUTH_ALLOWED_ORIGINS=["http://localhost:3000"]

# Login rate limiting (P2-001, doc 22): sliding window per client IP and per
# normalized account, backed by the login_rate_buckets table. Fail-closed when
# the table is missing, so run migrations before exposing login.
AUTH_LOGIN_RATE_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_IP_MAX_ATTEMPTS=20
AUTH_LOGIN_RATE_ACCOUNT_MAX_ATTEMPTS=5

# Model provider
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_STRICT_BASE_URL=https://api.deepseek.com/beta
MODEL_NAME=deepseek-v4-pro
MODEL_API_KEY=
MODEL_SUPPORTS_STRUCTURED_OUTPUT=true
MODEL_THINKING_ENABLED=true
MODEL_TIMEOUT_SECONDS=90

# Read-only external source providers. At least one is required for live Gate 0.
EXA_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Gate 0 capacity contract
LUDUS_CAPACITY_PROFILE=six_agent_72h
LUDUS_AGENT_SLOTS=6

# Offline development may use fixtures, but fixtures must never impersonate live data.
FIXTURE_MODE=true

# A2A remote-agent prototype (PandaAI track). OFF by default: leaving
# A2A_ENABLED unset keeps the deployed service byte-identical to the
# pre-A2A behavior (switch-back guarantee).
A2A_ENABLED=false
A2A_PUBLIC_URL=http://localhost:8000
A2A_AGENT_NAME=Ludus Five-Lens Research Agent
A2A_AGENT_VERSION=1.0.0
A2A_TASK_BUDGET_SECONDS=900
A2A_MAX_MODEL_CALLS=24
# Optional: override when method-packs/ lives outside the repo layout (e.g.
# mounted into a container at /app/method-packs).
# A2A_METHOD_PACK_ROOT=/app/method-packs

# PandaAI data skills (quotes/fundamentals/factors). Official access is the
# panda_data Python SDK: set PANDAAI_USERNAME (86 + registered phone number)
# and PANDAAI_PASSWORD (same as the PandaAI website password). The REST pair
# below is a fallback only. With neither configured the agent still runs but
# openly reports "no market data fetched".
PANDAAI_USERNAME=
PANDAAI_PASSWORD=
PANDAAI_DATA_BASE_URL=
PANDAAI_DATA_API_KEY=
PANDAAI_DATA_TIMEOUT_SECONDS=30