{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ludus:method:hardtech-market-direction:challenge:1.1.0",
  "title": "Hardtech Market Direction Challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspaceId",
    "decisionCaseId",
    "analysisRunId",
    "category",
    "text",
    "severity",
    "affectedOptionIds",
    "evidenceIds",
    "status"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "workspaceId": { "$ref": "#/$defs/id" },
    "decisionCaseId": { "$ref": "#/$defs/id" },
    "analysisRunId": { "$ref": "#/$defs/id" },
    "category": {
      "enum": [
        "core_assumption",
        "counterargument",
        "failure_pattern",
        "stakeholder_resistance",
        "bias",
        "fatal_flaw",
        "blind_spot"
      ]
    },
    "text": { "$ref": "#/$defs/longText" },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "affectedOptionIds": { "$ref": "#/$defs/idArray" },
    "evidenceIds": { "$ref": "#/$defs/idArray" },
    "mitigation": { "$ref": "#/$defs/longText" },
    "status": { "enum": ["draft", "confirmed", "rejected"] }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "longText": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "idArray": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  }
}
