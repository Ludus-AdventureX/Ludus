{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ludus:method:hardtech-market-direction:focused-result:1.1.0",
  "title": "Hardtech Market Direction Focused Research Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "methodId",
    "methodVersion",
    "methodContentHash",
    "executiveBrief",
    "recommendation",
    "evidenceReview",
    "counterArguments",
    "residualUncertainty",
    "qualityGate",
    "originModes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "methodId": {
      "const": "hardtech-market-direction"
    },
    "methodVersion": {
      "const": "1.1.0"
    },
    "methodContentHash": {
      "$ref": "#/$defs/sha256"
    },
    "executiveBrief": {
      "$ref": "#/$defs/briefSection"
    },
    "recommendation": {
      "$ref": "#/$defs/recommendation"
    },
    "evidenceReview": {
      "$ref": "#/$defs/evidenceReview"
    },
    "counterArguments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "urn:ludus:method:hardtech-market-direction:challenge:1.1.0"
      }
    },
    "residualUncertainty": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/unknownItem"
      }
    },
    "qualityGate": {
      "$ref": "#/$defs/reportValidation"
    },
    "originModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "live",
          "cached",
          "fixture"
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "idArray": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "nonEmptyTextArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/longText"
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "operator",
        "value",
        "actionIfMissed"
      ],
      "properties": {
        "metric": {
          "$ref": "#/$defs/text"
        },
        "operator": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "="
          ]
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "actionIfMissed": {
          "$ref": "#/$defs/longText"
        }
      }
    },
    "briefSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "whyNow",
        "conditions",
        "thresholds",
        "exitCriteria",
        "reviewDate"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/longText"
        },
        "whyNow": {
          "$ref": "#/$defs/longText"
        },
        "conditions": {
          "$ref": "#/$defs/nonEmptyTextArray"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/threshold"
          }
        },
        "exitCriteria": {
          "$ref": "#/$defs/nonEmptyTextArray"
        },
        "reviewDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "leadingIndicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric",
        "expectedDirection",
        "threshold",
        "checkCadence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "metric": {
          "$ref": "#/$defs/text"
        },
        "expectedDirection": {
          "enum": [
            "up",
            "down",
            "stable"
          ]
        },
        "threshold": {
          "$ref": "#/$defs/text"
        },
        "checkCadence": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "actionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "owner",
        "dueAt",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/longText"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "dueAt": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "open",
            "done",
            "blocked"
          ]
        }
      }
    },
    "recommendationQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceAvailability",
        "claimSupport",
        "assumptionStability",
        "causalReliability",
        "strategicRobustness",
        "processQuality",
        "weakestDimension",
        "rationale"
      ],
      "properties": {
        "evidenceAvailability": {
          "enum": [
            "sufficient",
            "conditional",
            "insufficient",
            "blocked"
          ]
        },
        "claimSupport": {
          "enum": [
            "supported",
            "conflicted",
            "assumption_only",
            "unsupported"
          ]
        },
        "assumptionStability": {
          "enum": [
            "stable",
            "fragile",
            "fatal_unknown"
          ]
        },
        "causalReliability": {
          "enum": [
            "confirmed",
            "conditional",
            "draft",
            "rejected"
          ]
        },
        "strategicRobustness": {
          "enum": [
            "robust",
            "scenario_sensitive",
            "flip_detected"
          ]
        },
        "processQuality": {
          "enum": [
            "passed",
            "warning",
            "blocked"
          ]
        },
        "weakestDimension": {
          "enum": [
            "evidence_availability",
            "claim_support",
            "assumption_stability",
            "causal_reliability",
            "strategic_robustness",
            "process_quality"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyTextArray"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "alternativeOptionIds",
        "summary",
        "conditions",
        "thresholds",
        "exitCriteria",
        "risks",
        "fragileAssumptionIds",
        "leadingIndicators",
        "nextActions",
        "reviewDate",
        "quality"
      ],
      "properties": {
        "outcome": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "optionId"
              ],
              "properties": {
                "kind": {
                  "const": "option"
                },
                "optionId": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "reasonCodes",
                "rationale"
              ],
              "properties": {
                "kind": {
                  "const": "abstain"
                },
                "reasonCodes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "rationale": {
                  "$ref": "#/$defs/longText"
                }
              }
            }
          ]
        },
        "alternativeOptionIds": {
          "$ref": "#/$defs/idArray"
        },
        "summary": {
          "$ref": "#/$defs/longText"
        },
        "conditions": {
          "$ref": "#/$defs/nonEmptyTextArray"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/threshold"
          }
        },
        "exitCriteria": {
          "$ref": "#/$defs/nonEmptyTextArray"
        },
        "risks": {
          "$ref": "#/$defs/nonEmptyTextArray"
        },
        "fragileAssumptionIds": {
          "$ref": "#/$defs/idArray"
        },
        "leadingIndicators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/leadingIndicator"
          }
        },
        "nextActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/actionItem"
          }
        },
        "reviewDate": {
          "type": "string",
          "format": "date"
        },
        "quality": {
          "$ref": "#/$defs/recommendationQuality"
        }
      }
    },
    "evidenceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceIds",
        "conflictGroupIds",
        "freshnessWarnings"
      ],
      "properties": {
        "evidenceIds": {
          "$ref": "#/$defs/idArray"
        },
        "conflictGroupIds": {
          "$ref": "#/$defs/idArray"
        },
        "freshnessWarnings": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/longText"
          }
        }
      }
    },
    "unknownItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workspaceId",
        "decisionCaseId",
        "question",
        "priority",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "workspaceId": {
          "$ref": "#/$defs/id"
        },
        "decisionCaseId": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "$ref": "#/$defs/longText"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "acquisitionPlan": {
          "$ref": "#/$defs/longText"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "dueAt": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "accepted"
          ]
        }
      }
    },
    "reportValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "errors",
        "warnings",
        "checkedAt"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/longText"
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/longText"
          }
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
