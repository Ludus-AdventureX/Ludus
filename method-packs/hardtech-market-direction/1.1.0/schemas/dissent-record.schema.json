{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ludus:method:hardtech-market-direction:dissent-record:1.1.0",
  "title": "Structured Dissent Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "methodId",
    "methodVersion",
    "analysisRunId",
    "challengeIds",
    "minorityJudgmentIds",
    "unresolvedDisagreements",
    "falsificationConditions",
    "synthesisDisposition",
    "responsibility",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "methodId": {
      "const": "hardtech-market-direction"
    },
    "methodVersion": {
      "const": "1.1.0"
    },
    "analysisRunId": {
      "$ref": "#/$defs/id"
    },
    "challengeIds": {
      "$ref": "#/$defs/idArrayMinOne"
    },
    "minorityJudgmentIds": {
      "$ref": "#/$defs/idArray"
    },
    "unresolvedDisagreements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "falsificationConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "synthesisDisposition": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/disposition"
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsibility",
        "actorType",
        "createdAt"
      ],
      "properties": {
        "responsibility": {
          "const": "analysis"
        },
        "actorType": {
          "enum": [
            "system_service",
            "analysis_worker"
          ]
        },
        "actorId": {
          "$ref": "#/$defs/id"
        },
        "sourceAnalysisRunId": {
          "$ref": "#/$defs/id"
        },
        "producerRole": {
          "enum": [
            "research",
            "critic",
            "synthesis",
            "validation"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "contentHash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "idArrayMinOne": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "disposition",
        "reason"
      ],
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "disposition": {
          "enum": [
            "accepted",
            "mitigated",
            "unresolved",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
