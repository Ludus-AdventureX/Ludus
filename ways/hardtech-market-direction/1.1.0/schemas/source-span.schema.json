{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ludus:method:hardtech-market-direction:source-span:1.1.0",
  "title": "Frozen Source Span",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "methodId",
    "methodVersion",
    "sourceSpanId",
    "sourceRecordId",
    "materialSnapshotHash",
    "locator",
    "quote",
    "quoteHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "methodId": {
      "const": "hardtech-market-direction"
    },
    "methodVersion": {
      "const": "1.1.0"
    },
    "sourceSpanId": {
      "$ref": "#/$defs/id"
    },
    "sourceRecordId": {
      "$ref": "#/$defs/id"
    },
    "materialSnapshotHash": {
      "$ref": "#/$defs/hash"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "text",
            "pdf",
            "table",
            "human_input"
          ]
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "paragraphIndex": {
          "type": "integer",
          "minimum": 0
        },
        "charStart": {
          "type": "integer",
          "minimum": 0
        },
        "charEnd": {
          "type": "integer",
          "minimum": 0
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "rowStart": {
          "type": "integer",
          "minimum": 1
        },
        "rowEnd": {
          "type": "integer",
          "minimum": 1
        },
        "columnStart": {
          "type": "integer",
          "minimum": 1
        },
        "columnEnd": {
          "type": "integer",
          "minimum": 1
        },
        "caseFieldPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "messageId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "quoteHash": {
      "$ref": "#/$defs/hash"
    },
    "contextBefore": {
      "type": "string",
      "maxLength": 2000
    },
    "contextAfter": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
